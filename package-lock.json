{
  "name": "ojs-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ojs-monorepo",
      "workspaces": [
        "packages/*",
        "examples/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "examples/demo": {
      "name": "ojs-demo",
      "version": "1.0.0",
      "dependencies": {
        "@ocardona0712/ojs-framework": "^1.1.0"
      }
    },
    "node_modules/@ocardona0712/ojs-framework": {
      "resolved": "packages/ojs-framework",
      "link": true
    },
    "node_modules/create-ojs-app": {
      "resolved": "packages/create-ojs-app",
      "link": true
    },
    "node_modules/ojs-demo": {
      "resolved": "examples/demo",
      "link": true
    },
    "packages/create-ojs-app": {
      "version": "1.0.0",
      "license": "MIT",
      "bin": {
        "create-ojs-app": "index.js"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/ojs-framework": {
      "name": "@ocardona0712/ojs-framework",
      "version": "1.1.0",
      "license": "MIT",
      "bin": {
        "ojs": "bin/ojs.js"
      },
      "engines": {
        "node": ">=18"
      }
    }
  }
}
